# Environment Configuration for Unified Security Platform

# Database Configuration
DB_HOST=unified-db
DB_USER=security_user
DB_PASS=change_me_db_password
DB_NAME=unified_security
DB_ROOT_PASS=change_me_root_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Security Configuration
JWT_SECRET=your-secret-key-change-me-in-production
FLASK_DEBUG=false

# External API Keys
NVD_API_KEY=

# Network Configuration
FALLBACK_SUBNET=192.168.1.0/24
SCAN_INTERFACE=eth0

# Service URLs (for internal communication)
VULNERABILITY_SERVICE_URL=http://vulnerability-scanner:5001
TRAFFIC_SERVICE_URL=http://traffic-analyzer:5002
CORRELATION_SERVICE_URL=http://correlation-engine:5003

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://elasticsearch:9200

# Kibana Configuration
KIBANA_URL=http://kibana:5601

# API Gateway Configuration
API_GATEWAY_URL=http://api-gateway:8000
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW=3600

# Web Dashboard Configuration
WEB_DASHBOARD_URL=http://web-dashboard:80

# Suricata Configuration
SURICATA_CONFIG_PATH=/etc/suricata
SURICATA_LOGS_PATH=/var/log/suricata
